# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Loaded once at startup by app/vlm/config.py — restart the app after editing.

# --- Experimental VLM pipeline (POST /analyze/vlm) ---
GEMINI_API_KEY=your_api_key
VLM_PROVIDER=gemini
# Any vision-capable model from client.models.list(). gemini-3.8-flash was
# very slow on 2026-10-31 (504s at ~60-120 s even for text); gemini-3.5-flash
# answered a text ping in ~1 s.
VLM_MODEL=gemini-3.8-flash
VLM_DEBUG=true
# Accepted but ignored: VLM results are never written to the database yet.
VLM_PERSIST_RESULTS=false

# --- Optional tuning (defaults shown) ---
# VLM_REQUEST_TIMEOUT_SECONDS=120
# VLM_MAX_RETRIES=2                  # 429 / 5xx / connection errors only
# VLM_RETRY_ON_TIMEOUT=false         # timeouts may still be billed
# VLM_RETRY_BASE_DELAY_SECONDS=2
# VLM_MAX_CONCURRENCY=3              # parallel tile requests
# VLM_TILE_SIZE=2048                 # px, original-image coordinates
# VLM_TILE_OVERLAP=256
# VLM_MAX_TILES=24
# VLM_MAX_SEND_DIMENSION=3072        # longest side sent to the model
# VLM_MAX_IMAGE_PIXELS=60000000
# VLM_MAX_UPLOAD_MB=40
# VLM_MAX_OUTPUT_TOKENS=32768
# VLM_MEDIA_RESOLUTION=high          # low | medium | high
# VLM_THINKING_LEVEL=                # low | medium | high (model-dependent; unset = model default)
# VLM_PRICE_INPUT_PER_MTOK=          # USD per 1M input tokens, enables cost estimate
# VLM_PRICE_OUTPUT_PER_MTOK=         # USD per 1M output (+thinking) tokens
